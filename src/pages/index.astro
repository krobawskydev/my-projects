---

import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../sections/hero/Hero.astro'
import FeaturedProjects from '../sections/projects/FeaturedProjects.astro'
import SkillsSection from '../sections/skills/SkillsSection.astro'
import AboutSection from '../sections/about/AboutSection.astro'
import ContactSection from '../sections/contact/ContactSection.astro'

import { getFeaturedProjects, getSkillsByCategory } from '../lib/supabase/queries'
import type { SkillCategory } from '../types/skill'

const featuredProjects = await getFeaturedProjects()
const skillsByCategory = await getSkillsByCategory()

const skillsByCategoryTyped = skillsByCategory as Partial<Record<SkillCategory, Array<{ name: string; category: string }>>>
---

<BaseLayout
  title="Home"
  description="Ricardo Berrospi Quispe is a senior mobile and fullstack engineer building scalable fintech, enterprise SaaS, and production mobile applications."
>
  <Hero />
  {
    featuredProjects.length > 0 && <FeaturedProjects projects={featuredProjects} />
  }
  <SkillsSection skillsByCategory={skillsByCategoryTyped} />
  <AboutSection />
  <ContactSection />
</BaseLayout>
