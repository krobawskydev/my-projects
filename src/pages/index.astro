---

import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../sections/hero/Hero.astro'
import FeaturedProjects from '../sections/projects/FeaturedProjects.astro'
import SkillsSection from '../sections/skills/SkillsSection.astro'
import AboutSection from '../sections/about/AboutSection.astro'
import ContactSection from '../sections/contact/ContactSection.astro'

import { getFeaturedProjects, getSkillsByCategory } from '../lib/content/queries'
import { getLocaleFromPathname, getTranslations } from '../i18n'
import type { SkillCategory } from '../types/skill'

const locale = getLocaleFromPathname(Astro.url.pathname)
const translations = getTranslations(locale)
const featuredProjects = await getFeaturedProjects(locale)
const skillsByCategory = await getSkillsByCategory()

const skillsByCategoryTyped = skillsByCategory as Partial<Record<SkillCategory, Array<{ name: string; category: string }>>>
---

<BaseLayout
  title={translations.meta.home.title}
  description={translations.meta.home.description}
  locale={locale}
>
  <Hero locale={locale} />
  {
    featuredProjects.length > 0 && <FeaturedProjects projects={featuredProjects} locale={locale} />
  }
  <SkillsSection skillsByCategory={skillsByCategoryTyped} locale={locale} />
  <AboutSection locale={locale} />
  <ContactSection locale={locale} />
</BaseLayout>
