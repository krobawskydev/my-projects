---

import BaseLayout from '../../layouts/BaseLayout.astro'
import Container from '../../components/ui/Container.astro'
import ProjectGrid from '../../components/projects/ProjectGrid.astro'
import { getProjects } from '../../lib/supabase/queries'

const projects = await getProjects()
---

<BaseLayout
  title="Projects"
  description="Explore selected engineering projects by Ricardo Berrospi Quispe across enterprise platforms, independent products, fintech systems, SaaS, and mobile applications."
>
  <section class="pt-32 pb-24">
    <Container>
      <div class="mb-16">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
          Portfolio
        </p>
        <h1 class="mt-4 text-3xl font-bold sm:text-4xl tracking-tight">
          All Projects
        </h1>
        <p class="mt-3 max-w-lg text-muted">
          Every project I've built — from enterprise platforms to independent products.
        </p>
      </div>

      <ProjectGrid projects={projects} />
    </Container>
  </section>
</BaseLayout>
