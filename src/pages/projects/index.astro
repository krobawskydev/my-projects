---

import BaseLayout from '../../layouts/BaseLayout.astro'
import Container from '../../components/ui/Container.astro'
import ProjectGrid from '../../components/projects/ProjectGrid.astro'
import { getProjects } from '../../lib/supabase/queries'
import { getLocaleFromPathname, getTranslations } from '../../i18n'

const locale = getLocaleFromPathname(Astro.url.pathname)
const translations = getTranslations(locale)
const projects = await getProjects()
---

<BaseLayout
  title={translations.meta.projects.title}
  description={translations.meta.projects.description}
  locale={locale}
>
  <section class="pt-32 pb-24">
    <Container>
      <div class="mb-16">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
          {translations.projects.all.eyebrow}
        </p>
        <h1 class="mt-4 text-3xl font-bold sm:text-4xl tracking-tight">
          {translations.projects.all.title}
        </h1>
        <p class="mt-3 max-w-lg text-muted">
          {translations.projects.all.description}
        </p>
      </div>

      <ProjectGrid projects={projects} locale={locale} />
    </Container>
  </section>
</BaseLayout>
