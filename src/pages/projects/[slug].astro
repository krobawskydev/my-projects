---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import {
  getProjectBySlugWithSkills,
  getAllProjectSlugs,
} from "../../lib/content/queries";
import { getLocaleFromPathname, getTranslations, localizePath } from "../../i18n";
import {
  getProjectTypeLabel,
  PROJECT_TYPE_VARIANTS,
} from "../../types/project";

export async function getStaticPaths() {
  const slugs = await getAllProjectSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const locale = getLocaleFromPathname(Astro.url.pathname);
const translations = getTranslations(locale);
const project = await getProjectBySlugWithSkills(slug!, locale);

if (!project) {
  return Astro.redirect(localizePath("/404", locale));
}

const skills = project.skills ?? [];
const typeLabel = getProjectTypeLabel(locale, project.project_type);
const typeVariant = PROJECT_TYPE_VARIANTS[project.project_type];
---

<BaseLayout
  title={project.title}
  description={project.short_description}
  image={project.cover_image}
  locale={locale}
>
  <article class="pt-28 pb-24">
    <Container>
      <div class="mb-10">
        <a
          href={`${localizePath("/", locale)}#enterprise`}
          class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors duration-200 hover:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          {translations.projects.detail.back}
        </a>
      </div>

      <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-5">
            <span
              class={`inline-flex items-center rounded-md px-2.5 py-1 text-xs font-medium uppercase tracking-wider ${typeVariant}`}
            >
              {typeLabel}
            </span>
            {
              project.featured && (
                <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-medium uppercase tracking-wider border border-accent/20 bg-accent/10 text-accent">
                  {translations.projects.detail.featured}
                </span>
              )
            }
          </div>

          <h1
            class="text-3xl font-bold sm:text-4xl lg:text-5xl tracking-tight leading-[1.05]"
          >
            {project.title}
          </h1>

          <p class="mt-4 text-lg text-muted max-w-2xl leading-relaxed">
            {project.short_description}
          </p>
        </div>

        <div class="space-y-5">
          {
            project.role && (
              <div>
                <p class="text-xs uppercase tracking-widest text-muted mb-1">
                  {translations.projects.detail.role}
                </p>
                <p class="text-sm font-medium">{project.role}</p>
              </div>
            )
          }
          {
            project.company && (
              <div>
                <p class="text-xs uppercase tracking-widest text-muted mb-1">
                  {translations.projects.detail.company}
                </p>
                <p class="text-sm font-medium">{project.company}</p>
              </div>
            )
          }
          {
            project.duration && (
              <div>
                <p class="text-xs uppercase tracking-widest text-muted mb-1">
                  {translations.projects.detail.duration}
                </p>
                <p class="text-sm font-medium">{project.duration}</p>
              </div>
            )
          }
          {
            project.team_size && (
              <div>
                <p class="text-xs uppercase tracking-widest text-muted mb-1">
                  {translations.projects.detail.teamSize}
                </p>
                <p class="text-sm font-medium">{project.team_size}</p>
              </div>
            )
          }
        </div>
      </div>

      <div class="mt-8 mb-12 flex flex-wrap gap-2">
        {skills.map((skill: any) => <Badge>{skill.name}</Badge>)}
      </div>

      {
        project.cover_image && (
          <div class="mb-14 overflow-hidden rounded-xl border border-border bg-elevated">
            <div class="relative aspect-video overflow-hidden">
              <img
                src={project.cover_image}
                alt=""
                width="1200"
                height="675"
                class="absolute inset-0 h-full w-full scale-110 object-cover opacity-35 blur-2xl"
                aria-hidden="true"
              />
              <div class="absolute inset-0 bg-background/25" aria-hidden="true"></div>
              <img
                src={project.cover_image}
                alt={project.title}
                width="1200"
                height="675"
                class="relative h-full w-full object-contain p-6 sm:p-8"
                decoding="async"
                fetchpriority="high"
                sizes="(min-width: 1024px) 896px, 100vw"
              />
            </div>
          </div>
        )
      }

      {
        project.highlights && project.highlights.length > 0 && (
          <div class="mb-14">
            <h2 class="text-sm font-medium uppercase tracking-[0.2em] text-accent mb-6">
              {translations.projects.detail.keyHighlights}
            </h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {project.highlights.map((highlight: string) => (
                <div class="flex items-start gap-3 rounded-lg border border-border bg-surface p-4">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 shrink-0 text-accent"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span class="text-sm text-muted">{highlight}</span>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <div class="max-w-none">
        <h2
          class="text-sm font-medium uppercase tracking-[0.2em] text-accent mb-6"
        >
          {translations.projects.detail.caseStudy}
        </h2>
        <div class="text-muted leading-relaxed space-y-5 text-base sm:text-lg">
          {
            project.content
              .split("\n")
              .filter(Boolean)
              .map((paragraph: string) => <p>{paragraph}</p>)
          }
        </div>
      </div>

      {
        project.gallery && project.gallery.length > 0 && (
          <div class="mt-16">
            <h2 class="text-sm font-medium uppercase tracking-[0.2em] text-accent mb-6">
              {translations.projects.detail.screenshots}
            </h2>
            <div class="grid gap-6 sm:grid-cols-2">
              {project.gallery.map((image: string) => (
                <div class="overflow-hidden rounded-xl border border-border">
                  <img src={image} alt="" class="w-full" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        )
      }

      <div class="mt-16 flex flex-wrap gap-4 pt-8 border-t border-border">
        {
          project.github_url && (
            <Button
              href={project.github_url}
              variant="secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              {translations.projects.detail.viewSource}
            </Button>
          )
        }
        {
          project.live_url && (
            <Button
              href={project.live_url}
              variant="primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
              {translations.projects.detail.liveDemo}
            </Button>
          )
        }
      </div>
    </Container>
  </article>
</BaseLayout>
