---

import type { Project, ProjectType } from '../../types/project'
import { getProjectTypeLabel, PROJECT_TYPE_VARIANTS } from '../../types/project'
import { localizePath, t, type Locale } from '../../i18n'

export interface Props {
  project: Pick<Project, 'title' | 'slug' | 'short_description' | 'cover_image' | 'featured' | 'project_type' | 'role' | 'company' | 'duration'>
  locale: Locale
}

const { project, locale } = Astro.props
const { title, slug, short_description, cover_image, featured, project_type, role, company, duration } = project

const typeLabel = getProjectTypeLabel(locale, project_type)
const typeVariant = PROJECT_TYPE_VARIANTS[project_type]

---

<a
  href={localizePath(`/projects/${slug}`, locale)}
  class="group block rounded-xl border border-border bg-surface overflow-hidden transition-all duration-300 hover:border-accent/20 hover:bg-elevated hover:-translate-y-0.5"
>
  <div class="aspect-video overflow-hidden bg-elevated relative">
    {
      cover_image ? (
        <img
          src={cover_image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center">
          <span class="text-6xl font-bold text-foreground/5">{title[0]}</span>
        </div>
      )
    }

    <div class="absolute top-3 left-3 flex flex-wrap gap-2">
      <span class={`inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider ${typeVariant}`}>
        {typeLabel}
      </span>
      {
        featured && (
          <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider border border-accent/20 bg-accent/10 text-accent">
            {t(locale, 'projects.detail.featured')}
          </span>
        )
      }
    </div>
  </div>

  <div class="p-5">
    <div class="flex items-center gap-2 text-xs text-muted mb-2">
      {company && <span class="font-medium text-foreground/80">{company}</span>}
      {company && role && <span class="text-border">/</span>}
      {role && <span>{role}</span>}
      {duration && <><span class="text-border">·</span><span>{duration}</span></>}
    </div>

    <h3 class="text-lg font-semibold text-foreground transition-colors duration-200 group-hover:text-accent">
      {title}
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-muted line-clamp-2">
      {short_description}
    </p>

    <div class="mt-4 flex items-center text-sm font-medium text-accent opacity-0 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-1">
      {t(locale, 'projects.detail.caseStudy')}
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1">
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    </div>
  </div>
</a>
