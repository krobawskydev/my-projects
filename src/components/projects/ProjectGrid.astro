---

import ProjectCard from './ProjectCard.astro'
import type { Project } from '../../types/project'
import { t, type Locale } from '../../i18n'

export interface Props {
  projects: Pick<Project, 'title' | 'slug' | 'short_description' | 'cover_image' | 'featured' | 'project_type' | 'role' | 'company' | 'duration'>[]
  columns?: 2 | 3
  locale: Locale
}

const { projects, columns = 2, locale } = Astro.props

const gridCols = columns === 3
  ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'
  : 'grid-cols-1 sm:grid-cols-2'

---

{
  projects.length > 0 ? (
    <div class={`grid ${gridCols} gap-6`}>
      {
        projects.map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))
      }
    </div>
  ) : (
    <p class="text-center text-muted py-12">{t(locale, 'projects.empty')}</p>
  )
}
