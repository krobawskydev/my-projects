---

export interface Props {
  class?: string
  accent?: boolean
}

const { class: className, accent = false } = Astro.props

const baseStyles =
  'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium transition-colors duration-200'

const colorStyles = accent
  ? 'bg-accent/10 text-accent border border-accent/20'
  : 'bg-surface text-muted border border-border'

---

<span class={`${baseStyles} ${colorStyles} ${className ?? ''}`}>
  <slot />
</span>
