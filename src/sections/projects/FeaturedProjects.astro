---

import Container from '../../components/ui/Container.astro'
import ProjectGrid from '../../components/projects/ProjectGrid.astro'
import type { Project, ProjectType } from '../../types/project'
import { getProjectTypeLabel } from '../../types/project'
import { t, type Locale } from '../../i18n'

export interface Props {
  projects: Pick<Project, 'title' | 'slug' | 'short_description' | 'cover_image' | 'featured' | 'project_type' | 'role' | 'company' | 'duration'>[]
  locale: Locale
}

const { projects, locale } = Astro.props
const projectTypeOrder: ProjectType[] = ['enterprise', 'startup', 'freelance', 'personal', 'landing_page']

const projectGroups = projectTypeOrder
  .map((type) => ({
    type,
    label: getProjectTypeLabel(locale, type),
    projects: projects.filter((project) => project.project_type === type),
  }))
  .filter((group) => group.projects.length > 0)

let hasIndependentAnchor = false
const projectSections = projectGroups.map((group) => {
  if (group.type === 'enterprise') {
    return { ...group, anchorId: 'enterprise' }
  }

  if (!hasIndependentAnchor) {
    hasIndependentAnchor = true
    return { ...group, anchorId: 'independent' }
  }

  return { ...group, anchorId: undefined }
})

---

<section id="featured" class="py-24 sm:py-32">
  <Container>
    <div class="mb-16">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">
        {t(locale, 'projects.eyebrow')}
      </p>
      <h2 class="mt-4 text-3xl font-bold sm:text-4xl tracking-tight">
        {t(locale, 'projects.title')}
      </h2>
      <p class="mt-3 max-w-lg text-muted">
        {t(locale, 'projects.description')}
      </p>
    </div>

    <div class="space-y-14">
      {
        projectSections.map((group) => (
          <div id={group.anchorId} class="scroll-mt-24">
            <div class="mb-6 flex items-center gap-3">
              <h3 class="text-lg font-semibold tracking-tight">
                {group.label}
              </h3>
              <span class="h-px flex-1 bg-border" />
            </div>

            <ProjectGrid projects={group.projects} locale={locale} />
          </div>
        ))
      }
    </div>
  </Container>
</section>
