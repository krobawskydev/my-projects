---


import Container from '../../components/ui/Container.astro'
import ProjectGrid from '../../components/projects/ProjectGrid.astro'

export interface Props {
  projects: Array<{
    title: string
    slug: string
    short_description: string
    cover_image: string
    featured: boolean
  }>
}

const { projects } = Astro.props

---

<section id="work" class="py-24 sm:py-32">
  <Container>
    <div class="mb-16">
      <p class="text-sm font-medium uppercase tracking-widest text-accent">
        Portfolio
      </p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
        Selected Work
      </h2>
      <p class="mt-4 max-w-lg text-muted">
        A curated selection of projects I&apos;ve built. Each project reflects my commitment to quality, performance, and thoughtful design.
      </p>
    </div>

    <ProjectGrid projects={projects} />
  </Container>
</section>
