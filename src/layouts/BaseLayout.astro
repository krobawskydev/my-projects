---

import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Navbar from '../components/ui/Navbar.astro'
import Footer from '../components/ui/Footer.astro'
import {
  defaultLocale,
  getAlternateLocalePath,
  getTranslations,
  locales,
  type Locale,
} from '../i18n'

export interface Props {
  title: string
  description?: string
  image?: string
  locale?: Locale
}

const defaultImage = '/brand/logo.svg'

const {
  title,
  image = defaultImage,
  locale = defaultLocale,
  description = getTranslations(locale).meta.defaultDescription,
} = Astro.props

const siteName = 'krobawsky.dev'
const author = 'Ricardo Berrospi Quispe'
const pageTitle = `${title} — ${siteName}`
const siteOrigin = Astro.site ?? Astro.url.origin
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString()
const imageUrl = new URL(image || defaultImage, siteOrigin).toString()
const alternateLinks = locales.map((alternateLocale) => ({
  locale: alternateLocale,
  href: new URL(getAlternateLocalePath(Astro.url.pathname, alternateLocale), siteOrigin).toString(),
}))

---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLinks.map((alternate) => (
        <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getAlternateLocalePath(Astro.url.pathname, defaultLocale), siteOrigin).toString()}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Navbar locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
