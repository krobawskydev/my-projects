---

import '../styles/global.css'
import Navbar from '../components/ui/Navbar.astro'
import Footer from '../components/ui/Footer.astro'

export interface Props {
  title: string
  description?: string
  image?: string
}

const { title, description = 'Senior Mobile & Fullstack Engineer. Building production systems at scale across fintech, enterprise SaaS, and modern mobile applications.', image } = Astro.props

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} — krobawsky.dev</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — krobawsky.dev`} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — krobawsky.dev`} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
